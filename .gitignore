data/*
!data/.gitkeep

# Bases SQLite y diarios
# PG-08B/PG-08C: bases de desarrollo aisladas; NUNCA deben versionarse.
data/shared-pg08b.db
data/shared-pg08b.db-wal
data/shared-pg08b.db-shm
data/shared-pg08c.db
data/shared-pg08c.db-wal
data/shared-pg08c.db-shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Partidas y volcados de cartucho (solo los fixtures revisados)
*.srm
*.sav
*.dsv
*.bin
!fixtures/*.srm

# Credenciales y secretos
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.token
*.secret
secrets/
credentials/

# Node / Bun
node_modules/
dist/
.vite/
.cache/
.bun/

# .NET
bin/
obj/
*.user
*.suo

# Logs, temporales y respaldos
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.pre-rotacion.*

# Sistema operativo y editores
.DS_Store
Thumbs.db
